@model ProductClient.Models.Product?
@using System.Globalization
@{
    ViewData["Title"] = "Информация о товаре";
}

<h1>Информация о товаре</h1>

@if (ViewBag.ErrorMessage is string error)
{
    <div class="alert alert-warning" role="alert">@error</div>
}
else if (Model is not null)
{
    <div class="card shadow-sm mt-3">
        <div class="card-header fw-semibold">@Model.Name</div>
        <dl class="row card-body mb-0">
            <dt class="col-sm-3">ID</dt><dd class="col-sm-9">@Model.Id</dd>
            <dt class="col-sm-3">Название</dt><dd class="col-sm-9">@Model.Name</dd>
            <dt class="col-sm-3">Описание</dt><dd class="col-sm-9">@Model.Description</dd>
            <dt class="col-sm-3">Цена</dt><dd class="col-sm-9">@Model.Price.ToString("N0", CultureInfo.GetCultureInfo("ru-RU")) ₸</dd>
            <dt class="col-sm-3">Количество</dt><dd class="col-sm-9">@Model.Quantity</dd>
        </dl>
    </div>
    <div class="mt-3">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">Изменить</a>
        <a asp-action="Index" class="btn btn-link">К списку</a>
    </div>
}
else
{
    <p>Введите ID товара на странице списка.</p>
}

<a asp-action="Index" class="btn btn-link px-0 mt-3">Вернуться к списку товаров</a>
