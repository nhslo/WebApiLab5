@model ProductClient.Models.Product
@using System.Globalization
@{
    ViewData["Title"] = "Удалить товар";
}

<h1>Удалить товар</h1>
<div class="alert alert-warning">Подтвердите удаление. После подтверждения клиент отправит DELETE в Web API.</div>
<div class="card shadow-sm mb-3">
    <div class="card-body">
        <h2 class="h5">@Model.Name</h2>
        <p class="mb-1">ID: @Model.Id</p>
        <p class="mb-1">Описание: @Model.Description</p>
        <p class="mb-1">Цена: @Model.Price.ToString("N0", CultureInfo.GetCultureInfo("ru-RU")) ₸</p>
        <p class="mb-0">Количество: @Model.Quantity</p>
    </div>
</div>
<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">Подтвердить удаление</button>
    <a asp-action="Index" class="btn btn-link">Отмена</a>
</form>
